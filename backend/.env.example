# =============================================================================
# CliniCore / ClinicFlow — Safe Environment Variable Template (.env.example)
# IMPORTANT: Never commit actual passwords, private keys, or API tokens.
# =============================================================================

# Application Settings
APP_NAME=CliniCore
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.clinicore.me

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinicore
DB_USERNAME=clinicore_user
DB_PASSWORD=your_secure_random_db_password_here

# JWT Authentication (HMAC-SHA256 — Generate with `openssl rand -hex 32`)
JWT_SECRET=your_secure_256_bit_random_jwt_secret_here
JWT_EXPIRY=604800

# Transactional Email (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL=admin@clinicore.me

# Master Scheduled Cron Key (Generate with `openssl rand -hex 16`)
CRON_SECRET_KEY=your_secure_random_cron_key_here

# Allowed CORS Origins (Comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=https://clinicore.me,https://www.clinicore.me,https://api.clinicore.me

# Frontend Public Variables (Safe for browser bundle)
VITE_API_URL=https://api.clinicore.me
VITE_CLERK_PUBLISHABLE_KEY=pk_live_placeholder
